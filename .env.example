# Nomor WhatsApp internasional tanpa tanda +, spasi, atau tanda baca.
TOKO_WHATSAPP=6281234567890

# true hanya jika koneksi ke aplikasi memakai HTTPS; false untuk pengujian lokal.
COOKIE_SECURE=false

# Alamat dan port lokal aplikasi; jangan gunakan 0.0.0.0 tanpa kebutuhan yang jelas.
HOST=127.0.0.1
PORT=3000
